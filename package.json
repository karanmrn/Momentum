{
  "name": "streetwise",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "start": "tsx server/dev.ts",
    "format": "prettier --write src packages server services api tests/e2e",
    "test:server": "tsc -p tsconfig.server.json && node scripts/check-native-server.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "context.dev": "^2.14.0",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
